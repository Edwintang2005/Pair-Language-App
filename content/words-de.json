      "noun": { "gender": "f", "plural": "Zeiten" },
      "examples": [{ "text": "Hast du Zeit?", "english": "Do you have time?" }],
      "tip": "Time as an amount (Zeit haben). For clock time use Uhr. Keine Zeit! = no time!"
