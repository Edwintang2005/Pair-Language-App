    {
      "id": "de-kaufen", "word": "kaufen", "gloss": "to buy", "pos": "verb",
      "verb": { "present3sg": "kauft", "participle": "gekauft", "auxiliary": "haben" },
      "examples": [{ "text": "Ich kaufe Brot.", "english": "I'm buying bread." }],
      "tip": "verkaufen = to sell, einkaufen = to go shopping. Prefixes change the meaning a lot in German."
    },
    {
      "id": "de-geld", "word": "Geld", "gloss": "money", "pos": "noun",
      "noun": { "gender": "n", "plural": null },
      "examples": [{ "text": "Ich habe kein Geld.", "english": "I have no money." }],
      "tip": "Usually no plural (Gelder means funds). Bargeld = cash. A good chance to practise kein."
    },
    {
      "id": "de-kosten", "word": "kosten", "gloss": "to cost", "pos": "verb",
      "verb": { "present3sg": "kostet", "participle": "gekostet", "auxiliary": "haben" },
      "examples": [{ "text": "Was kostet das?", "english": "How much is that?" }],
      "tip": "Was kostet das? is the shopping question. kosten also means 'to taste' food."
    },
    {
      "id": "de-viel", "word": "viel", "gloss": "much, a lot", "pos": "adjective",
      "examples": [{ "text": "Das kostet zu viel.", "english": "That costs too much." }],
      "tip": "viel (much) vs viele (many): viel Geld, viele Leute. Vielen Dank = many thanks."
